{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "swift", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CI tool pins, each under a `# renovate:` comment",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(\\s+extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*[A-Z0-9_]+:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "dependencyDashboard": false,
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 7am on monday"],
  "semanticCommits": "enabled",
  "semanticCommitType": "ci",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "separateMajorMinor": false
    }
  ]
}
