// Target-level settings for the openskycli dev tool, shared by Debug and Release.
#include "Signing.xcconfig"

SUPPORTED_PLATFORMS = macosx

// The CLI compiles the same engine sources as the app, so it needs the same isolation
// default. The structs shared with Metal reach both targets through the
// OpenSkyShaderTypes clang module on SWIFT_INCLUDE_PATHS, so the CLI no longer has to
// borrow the app target's bridging header.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// Shaders.metal lives in opensky/Engine and imports ShaderTypes.h from the module
// directory under SharedHeaders.
MTL_HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/opensky/SharedHeaders/ShaderTypes

// The vendored decode-only ffmpeg. A command-line tool has no bundle to embed into, so
// it loads the dylibs straight from .vendor at run time.
LD_RUNPATH_SEARCH_PATHS = $(inherited) $(SRCROOT)/.vendor/ffmpeg/lib
LIBRARY_SEARCH_PATHS = $(inherited) $(SRCROOT)/.vendor/ffmpeg/lib
OTHER_LDFLAGS = $(inherited) -lavcodec -lavutil -lswresample
