// Code signing for the targets that ship a signed binary: the app, the CLI, and the
// app-hosted unit test bundle. The values come from Config/Base.xcconfig, where a
// developer's gitignored Config/Local.xcconfig overrides them, so no identity or team
// is hard-coded in shared configuration. A command-line override still wins over both
// (CI runs `make test XCODEBUILD_FLAGS='CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM='`).
CODE_SIGN_IDENTITY = $(OPENSKY_CODE_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(OPENSKY_DEVELOPMENT_TEAM)
