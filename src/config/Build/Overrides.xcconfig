// Applied above every target, package targets included, through XCODE_XCCONFIG_FILE
// (Makefile and tools/xcodebuild-lib.sh). Project and target files cannot reach
// package targets. Keep only settings that have to apply there.

// Xcode builds a package target that both the app and a test bundle link as its
// dynamic variant, and its missing-dependency check still reads the static graph.
// So every framework variant warned about each declared dependency. Only the
// variants are mh_dylib here; tools/lint/module-graph.sh checks their imports.
// See docs/tools/environment.md.
OPENSKY_DIAGNOSE_MISSING_TARGET_DEPENDENCIES_mh_dylib = NO
DIAGNOSE_MISSING_TARGET_DEPENDENCIES = $(OPENSKY_DIAGNOSE_MISSING_TARGET_DEPENDENCIES_$(MACH_O_TYPE):default=YES)

// The C targets bring their own module.modulemap, so their framework variants have no
// module map to generate. With DEFINES_MODULE on, each variant warned that it found no
// umbrella header.
OPENSKY_DEFINES_MODULE_OpenSkyShaderTypes = NO
OPENSKY_DEFINES_MODULE_CFFmpeg = NO
OPENSKY_DEFINES_MODULE_CASTCEncoder = NO
DEFINES_MODULE = $(OPENSKY_DEFINES_MODULE_$(PRODUCT_NAME):default=$(inherited))

// Metal, for the shaders the OpenSkyShaders package target compiles. Shader warnings are
// errors, same as the Swift lint gate. swift build passes neither (docs/decisions/shader-library.md).
MTL_FAST_MATH = YES
MTL_TREAT_WARNINGS_AS_ERRORS = YES

// Compilation-cache keys must not depend on where a checkout or its build tree
// lives, or no other worktree can reuse an entry. Prefix mapping turns the checkout
// into /^src, the tree into /^derived, and products into /^built; it has to reach
// the package targets, which hold the engine. The build that ships passes
// OPENSKY_PREFIX_MAPPING=NO, so its dSYM names real source paths.
OPENSKY_PREFIX_MAPPING = YES
SWIFT_ENABLE_PREFIX_MAPPING = $(OPENSKY_PREFIX_MAPPING)
SWIFT_ENABLE_PROJECT_PREFIX_MAPPING = $(OPENSKY_PREFIX_MAPPING)
CLANG_ENABLE_PREFIX_MAPPING = $(OPENSKY_PREFIX_MAPPING)
CLANG_ENABLE_PROJECT_PREFIX_MAPPING = $(OPENSKY_PREFIX_MAPPING)
// SwiftPM names the package after the checkout folder and passes it to every
// compile as -package-name, which put each worktree's name in the keys.
SWIFT_PACKAGE_NAME = opensky
