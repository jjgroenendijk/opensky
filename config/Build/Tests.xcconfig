// Target-level settings for the two unit-test bundles — OpenSkyTests and
// OpenSkyRealDataTests — shared by Debug and Release. Both are app-hosted: each loads into
// a built, signed OpenSky.app, which is why they need the same signing inputs as the app
// itself.
//
// The bundle identifier is derived from the target name rather than written out, so the two
// bundles cannot end up sharing one identifier when a third test target appears. No
// permission grant is keyed to these identifiers: the tests run inside the app process,
// so macOS asks on behalf of the app.
#include "Signing.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = nl.jjgroenendijk.$(PRODUCT_NAME:rfc1034identifier)
TEST_HOST = $(BUILT_PRODUCTS_DIR)/OpenSky.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/OpenSky
BUNDLE_LOADER = $(TEST_HOST)

GENERATE_INFOPLIST_FILE = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
SWIFT_EMIT_LOC_STRINGS = NO
